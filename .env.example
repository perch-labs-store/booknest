# Copy this file to `.env.local` and fill in your own values. Never commit `.env.local`.
# Leave a section empty to keep that part in demo mode (the app still runs, with no saved data).

# --- Clerk (sign in / sign up) ---------------------------------------------------
# Clerk Dashboard -> API keys -> Publishable key (starts with pk_test_ or pk_live_).
# Safe in the browser. NEVER put the Clerk secret key (sk_…) in a VITE_ variable.
VITE_CLERK_PUBLISHABLE_KEY=

# --- Supabase (database, not used by the UI yet) ---------------------------------
# Supabase Dashboard -> Project Settings -> API
# Project URL, e.g. https://abcdefghijklmnop.supabase.co
VITE_SUPABASE_URL=
# Publishable key (sb_publishable_…) or the legacy `anon` key. Never the `service_role` key.
VITE_SUPABASE_ANON_KEY=

# --- Contact page ------------------------------------------------------------------
# No longer used: the contact email and company name now live in src/data/company.ts.
VITE_CONTACT_EMAIL=

# --- Push notifications ------------------------------------------------------------
# Public VAPID key. Generate a pair with:  npx web-push generate-vapid-keys
# The PRIVATE key goes only in Supabase secrets (see supabase/functions/send-push), never here.
VITE_VAPID_PUBLIC_KEY=

# --- Published websites ------------------------------------------------------------
# Your domain without https://, e.g. booknest.app. Published sites go at <username>.<domain>. Empty = publishing off.
VITE_ROOT_DOMAIN=
